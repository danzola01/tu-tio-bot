{
  "name": "tu-tio-bot",
  "version": "1.0.0",
  "description": "Discord server bot with independent game modules",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "deploy": "tsx src/deploy-commands.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "typecheck": "tsc --project tsconfig.check.json",
    "check": "npm run typecheck && npm run build && npm test && npm audit --audit-level=low",
    "wipe:overwatch": "tsx src/games/overwatch/wipe-history.ts",
    "preinstall": "node scripts/check-runtime.mjs",
    "runtime:check": "node scripts/check-runtime.mjs",
    "wipe": "npm run wipe:overwatch",
    "prestart": "node scripts/check-runtime.mjs",
    "predev": "node scripts/check-runtime.mjs",
    "prebuild": "node scripts/check-runtime.mjs && node scripts/clean-build.mjs",
    "check:audio": "tsx scripts/check-deadlock-audio.ts"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "quickchart-js": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "private": true
}
