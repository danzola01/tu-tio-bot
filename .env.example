DISCORD_TOKEN=replace-with-bot-token
CLIENT_ID=replace-with-application-id
GUILD_ID=replace-with-server-id
# Relative file: URLs stay relative to prisma/ for compatibility with existing installations.
DATABASE_URL="file:./dev.db"
NODE_ENV=development
# Optional: override the Discord application/team owner for objective editing.
# BOT_OWNER_ID=123456789012345678
# Optional: post a Deadlock Start clock button when someone in voice launches the game.
# Enable Presence Intent in the Developer Portal first, or login fails.
# DEADLOCK_START_PROMPT=true
# Development only: OpenRouter key for npm run generate:voices (never needed at runtime).
# OPENROUTER_API_KEY=
